{
  "version": "1.0",
  "created_at": "2026-02-05",
  "sync_on_lesson_complete": true,
  "mcp_servers": ["basic-memory", "context7"],
  "auto_index": true,
  "index_path": ".aidev/memory/kb/.index/lessons-index.json",
  "backup_before_sync": true,
  "cross_project_sync": {
    "enabled": true,
    "filter_tags": ["laravel", "docker", "react", "inertia"]
  },
  "sync_rules": {
    "on_lesson_create": {
      "action": "write_note",
      "mcp_server": "basic-memory",
      "template": "lesson_note"
    },
    "on_lesson_update": {
      "action": "update_note",
      "mcp_server": "basic-memory"
    },
    "on_similar_error": {
      "action": "search_notes",
      "mcp_server": "basic-memory",
      "auto_suggest": true
    }
  },
  "templates": {
    "lesson_note": {
      "title": "{title}",
      "content": "{full_content}",
      "tags": ["{category}", "{stack}", "{severity}"],
      "metadata": {
        "date": "{date}",
        "file": "{file}",
        "project": "gacpac-ti"
      }
    }
  },
  "commands": {
    "sync_all": "aidev mcp sync --all",
    "search_lessons": "aidev mcp search --type=lesson",
    "backup_lessons": "aidev mcp backup --path=.aidev/backups/lessons"
  }
}
