# =========================
# 1️⃣ Build Stage
# =========================
FROM node:18-alpine AS build

# Declarar argumento e transformá-lo em variável de ambiente
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Definir diretório de trabalho
WORKDIR /app

# Copiar apenas arquivos de dependências primeiro (para cache eficiente)
COPY package*.json ./

# Instalar dependências
RUN npm ci

# Copiar o restante do código-fonte
COPY . .

# Executar build do Vite (usando variável de ambiente)
RUN npm run build

# =========================
# 2️⃣ Production Stage
# =========================
FROM nginx:alpine

# Remover configuração padrão do Nginx e copiar a customizada
RUN rm -rf /etc/nginx/conf.d/*
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiar os arquivos compilados da etapa anterior
COPY --from=build /app/dist /usr/share/nginx/html

# Expor porta padrão
EXPOSE 80

# Rodar o Nginx em foreground (boa prática Docker)
CMD ["nginx", "-g", "daemon off;"]
