# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=sgaiti_db
DB_USER=sgaiti_user
DB_PASSWORD=sgaiti_pass

# Security
JWT_SECRET=your_jwt_secret_change_in_production

# CORS
CORS_ORIGIN=*

# Gemini API (optional)
GEMINI_API_KEY=your_gemini_api_key_here
